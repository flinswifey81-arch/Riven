<?xml version="1.0" encoding="utf-8"?>
<!-- The inset keeps the approved celestial mark inside Android's adaptive-icon safe zone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/riven_brand_icon" />
    </item>
</layer-list>
